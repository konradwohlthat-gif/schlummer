{
  "name": "schlummer",
  "version": "1.1.0",
  "description": "Einschlafhilfe für Netflix und Disney+ als Safari-Userscript",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm test && npm run build",
    "test:webkit": "xcrun swift test/webkit/harness.swift dist/schlummer.user.js",
    "test:webkit:still": "sh test/webkit/still-watching.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.2"
  }
}
